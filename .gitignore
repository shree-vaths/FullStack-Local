# Dependencies (restore with `npm install`)
node_modules/

# Build output (regenerate with `npm run build`)
dist/
coverage/

# SQLite runtime side files. The database itself (server/data/app.db) IS
# committed; these are temporary files SQLite manages while it is open.
*.db-wal
*.db-shm

# Environment and logs
.env
.env.*
*.log

# OS / editor
.DS_Store
.vscode/
.idea/

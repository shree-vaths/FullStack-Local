{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    // "Bundler" resolution lets us write extensionless imports. Code is executed
    // by tsx, so tsc is only used for type-checking (noEmit).
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "tests"]
}
